PORT=3000
# Obligatorio en producción. Mínimo 8 caracteres. No se envía al navegador.
SCREEN_CODE=
# URL /exec de la implementación de Google Apps Script.
APPS_SCRIPT_URL=
# Mismo secreto que BRIDGE_TOKEN en las propiedades de Apps Script.
APPS_SCRIPT_TOKEN=
# Snapshot local privado; en Railway se usa el disco persistente.
DATA_FILE=./data/november.json
